{
  "name": "dsh-rolesubagents",
  "version": "0.1.1",
  "description": "Role-based subagents for DeepSeek Harness: define worker, reviewer and other roles with their own model, instructions, context (fresh or fork) and read-only mode, and let the parent pick one per delegation.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "multi-agent",
    "roles"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Aero123421/dsh-rolesubagents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aero123421/dsh-rolesubagents.git"
  },
  "bugs": {
    "url": "https://github.com/Aero123421/dsh-rolesubagents/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && node scripts/check-lib.mjs",
    "check:lib": "node scripts/check-lib.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.2.1-alpha.3 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.3 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.2 <4.0.0-0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.3",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
